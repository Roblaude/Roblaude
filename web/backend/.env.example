# Port du serveur backend
PORT=3001

# Connexion MySQL (cf docker-compose.yml : user/pass/db = roblaude)
DATABASE_URL="mysql://roblaude:roblaude@localhost:3306/roblaude"

# Secret de signature des JWT — OBLIGATOIRE.
# Genere une cle aleatoire avec :  openssl rand -base64 32
JWT_SECRET=

# Origine autorisee pour le CORS (frontend Vite en dev)
CORS_ORIGIN=http://localhost:5173

# Broker MQTT (cf docker-compose.yml — service mosquitto)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
